<Window x:Class="Projet3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Projet3"
        mc:Ignorable="d"
        Title="Logiciel de nettoyage" Height="450" Width="800" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Icon="/website-icon-29482-Windows.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="130*"/>
            <RowDefinition Height="255*"/>
            <RowDefinition Height="0*"/>
            <RowDefinition Height="49*"/>
        </Grid.RowDefinitions>
        <Rectangle HorizontalAlignment="Center" Height="130" Stroke="Black" VerticalAlignment="Center" Width="800" Fill="#FF0B6985"/>
        <Label x:Name="titre" Content="Analyse du PC nécessaire" HorizontalAlignment="Left" Margin="72,0,0,0" VerticalAlignment="Top" Foreground="White" FontSize="30" FontWeight="Bold" FontFamily="Segoe UI" Height="53" Width="406"/>
        <Label Content="Espace à nettoyer : " HorizontalAlignment="Left" Margin="72,53,0,0" VerticalAlignment="Top" Foreground="White" FontSize="20" FontWeight="Bold" FontFamily="Segoe UI" Height="35" Width="192"/>
        <Label Content="Dernière analyse :" HorizontalAlignment="Left" Margin="72,86,0,0" VerticalAlignment="Top" Foreground="White" FontSize="20" FontWeight="Bold" FontFamily="Segoe UI" Height="34" Width="192"/>
        <Label x:Name="date" Content="Jamais" HorizontalAlignment="Left" Margin="264,86,0,0" VerticalAlignment="Top" Foreground="White" FontSize="20" FontWeight="Normal" FontFamily="Segoe UI" Height="34" Width="172"/>
        <Label x:Name="espace" Content="??? Mb" HorizontalAlignment="Left" Margin="264,54,0,0" VerticalAlignment="Top" Foreground="White" FontSize="20" FontWeight="Normal" FontFamily="Segoe UI" Height="34" Width="172"/>
        <Button Content="ANALYSER" HorizontalAlignment="Left" Height="65" Margin="505,31,0,0" VerticalAlignment="Top" Width="258" Click="Button_Click_Ana" BorderThickness="4,4,4,4" Background="{x:Null}" BorderBrush="White" Foreground="White" FontSize="20" FontFamily="Segoe UI" FontWeight="Bold"/>
        <Rectangle HorizontalAlignment="Center" Height="52" Stroke="White" VerticalAlignment="Top" Width="800" Fill="#FFC4CACB" Margin="0,252,0,0" Grid.Row="1" Grid.RowSpan="3"/>
        <Label x:Name="titre_Copy" Content="Copyright 2025 - Raphaël" HorizontalAlignment="Center" Margin="0,255,0,0" VerticalAlignment="Top" Foreground="Black" FontSize="14" FontWeight="Normal" FontFamily="Segoe UI" Height="29" Width="170" Grid.Row="1" Grid.RowSpan="3"/>
        <Button x:Name="btnClean" Content="&#xD;&#xA;&#xD;&#xA;NETTOYER" HorizontalAlignment="Left" Height="106" Margin="90,14,0,0" VerticalAlignment="Top" Width="280" Click="Button_Click_Net" BorderThickness="4,4,4,4" Background="#FF0B6985" BorderBrush="White" Foreground="White" FontSize="20" FontFamily="Segoe UI" FontWeight="Bold" Grid.Row="1"/>
        <Button Content="&#xA;&#xD;&#xA;MISE A JOUR" HorizontalAlignment="Left" Height="106" Margin="90,132,0,0" VerticalAlignment="Top" Width="280" Click="Button_Click_MAJ" BorderThickness="4,4,4,4" Background="#FF0B6985" BorderBrush="White" Foreground="White" FontSize="20" FontFamily="Segoe UI" FontWeight="Bold" Grid.Row="1"/>
        <Button Content="&#xA;&#xD;&#xA;HISTORIQUE" HorizontalAlignment="Left" Height="106" Margin="434,14,0,0" VerticalAlignment="Top" Width="282" Click="Button_Click_Histo" BorderThickness="4,4,4,4" Background="#FF0B6985" BorderBrush="White" Foreground="White" FontSize="20" FontFamily="Segoe UI" FontWeight="Bold" Grid.Row="1"/>
        <Button Content="&#xA;&#xD;&#xA;SITE WEB" HorizontalAlignment="Left" Height="106" Margin="434,132,0,0" VerticalAlignment="Top" Width="282" Click="Button_Click_Web" BorderThickness="4,4,4,4" Background="#FF0B6985" BorderBrush="White" Foreground="White" FontSize="20" FontFamily="Segoe UI" FontWeight="Bold" Grid.Row="1"/>
        <Image HorizontalAlignment="Left" Height="52" Margin="204,29,0,0" Grid.Row="1" VerticalAlignment="Top" Width="53" Source="/icons8-broom-70.png" IsHitTestVisible="False"/>
        <Image HorizontalAlignment="Left" Height="52" Margin="204,146,0,0" Grid.Row="1" VerticalAlignment="Top" Width="53" Source="/icons8-mise-à-jour-70.png" IsHitTestVisible="False"/>
        <Image HorizontalAlignment="Left" Height="52" Margin="549,29,0,0" Grid.Row="1" VerticalAlignment="Top" Width="53" Source="/icons8-plan-de-traitement-70.png" IsHitTestVisible="False"/>
        <Image HorizontalAlignment="Left" Height="52" Margin="549,146,0,0" Grid.Row="1" VerticalAlignment="Top" Width="53" Source="/icons8-site-internet-70.png" IsHitTestVisible="False"/>

    </Grid>
</Window>
