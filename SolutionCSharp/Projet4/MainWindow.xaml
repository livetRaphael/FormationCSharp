<Window x:Class="Projet4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Projet4"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Background="#FFD4D4D4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="7*"/>
            <ColumnDefinition Width="43*"/>
            <ColumnDefinition Width="43*"/>
            <ColumnDefinition Width="7*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="79*"/>
            <RowDefinition Height="300*"/>
            <RowDefinition Height="55*"/>
        </Grid.RowDefinitions>
        <Label Content="Choisis ton plat préféré" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="36" Grid.ColumnSpan="2" Width="378" Height="58" Margin="155,8,0,0"/>
        <Button x:Name="btnLeft" Content="" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Top" Height="300" Width="344" Click="btnLeft_Click" BorderBrush="#FF3069FF" Margin="0,78,0,0" Grid.RowSpan="2" BorderThickness="4,4,4,4">
            <Button.Background>
                <ImageBrush ImageSource="/Un-plat-familial-en-sauce-comme-chez-mamie.jpg"/>
            </Button.Background>
        </Button>
        <Button x:Name="btnRight" Content="" HorizontalAlignment="Center" VerticalAlignment="Top" Height="300" Width="343" Click="btnRight_Click" Grid.Column="2" Margin="0,78,0,0" Grid.RowSpan="2" BorderBrush="#FFAA1D1D" BorderThickness="4,4,4,4">
            <Button.Background>
                <ImageBrush ImageSource="/malkha-plat-marocain.jpg"/>
            </Button.Background>
        </Button>

    </Grid>
</Window>
